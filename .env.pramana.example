# Copy to .env.pramana. Keep credentials local; never commit that file.
SERPAPI_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
PRAMANA_MAX_SEARCHES=8
PRAMANA_MAX_TOOL_CALLS=16
PRAMANA_TIMEOUT_SECONDS=300
PRAMANA_MAX_CONCURRENT_CHATS=1
PRAMANA_RUNTIME_DB=data/runtime/pramana.sqlite
APIX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Historical analytical API only. Agent state uses PRAMANA_RUNTIME_DB separately.
APIX_READ_ONLY=1
APIX_SQLITE_IMMUTABLE=1
APIX_DB_PATH=data/deploy/apix.snapshot.sqlite
APIX_SNAPSHOT_MANIFEST=data/deploy/snapshot-manifest.json
PRAMANA_WARM_LEGACY_CACHE=0
