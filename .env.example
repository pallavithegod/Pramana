# Copy to .env and fill. NEVER commit .env or paste credentials into logs/chat.
# Preferred: authorized keys for this project, in failover order.
SERPAPI_KEYS=
# Backward-compatible single-key fallback (may be used instead of the list).
SERPAPI_KEY=
DATABASE_URL=sqlite:///data/lake/apix.sqlite   # swap for Neon Postgres URL later
COLLECTOR_USER_AGENT=AirSankhyiki-Research-Bot/0.1 (SIH26056 academic project; contact: <your-email>)

# Render read-only viewer only. Do not set these on the local scraper node.
APIX_READ_ONLY=0
APIX_SQLITE_IMMUTABLE=1
APIX_DB_PATH=data/deploy/apix.snapshot.sqlite
APIX_SNAPSHOT_MANIFEST=data/deploy/snapshot-manifest.json
APIX_CORS_ORIGINS=http://127.0.0.1:3000
APIX_REQUIRE_AUTH=0
